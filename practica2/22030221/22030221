class calcularP {
    public double resultadoPromedio; 

    public void calcular(double[] notas) {
        double suma = 0;
        for (int i = 0; i < notas.length; i++) {
            suma += notas[i];
        }
    
        resultadoPromedio = suma / notas.length; 
    }
}

