import java.util.Random;
import java.util.Scanner;

public class AdivinaNumero {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        int nRandom = random.nextInt(100) + 1;
        int nIntentos = 0;
        int maxIntentos = 7;
        boolean adivina = false;

        System.out.println(" Adivina el numero ");
        System.out.println(" Selecciona la dificultad");
        System.out.println(" 1.Facil 10 intentos       2.Medio 7 intentos        3.Dificil 5 intentos");
        
        int dificultad = scanner.nextInt();

        switch (dificultad) {
            case 1:
                maxIntentos = 10;
                break;
            case 2:
                maxIntentos = 7;
                break;
            case 3:
                maxIntentos = 5;
                break;
            default:
                System.out.println("Se seleccionara modo intermedio (7 intentos)");
                maxIntentos = 7;
                break;
        }

        while (nIntentos < maxIntentos) {
            System.out.print("Ingrese numero: ");
            int numero = scanner.nextInt();
            nIntentos++;

            if (numero == nRandom) {
                adivina = true;
                System.out.println("¡Correcto!");
                System.out.println("Numero de intentos utilizados: " + nIntentos);
                break; 
            } else if (numero < nRandom) {
                System.out.println("El numero es mayor");
            } else {
                System.out.println("El numero es menor");
            }
        }

        if (!adivina) {
            System.out.println("Juego terminado");
            System.out.println("El numero era: " + nRandom);
        }

    }
}